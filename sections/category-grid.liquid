<div class="section category-grid-section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__head">
        <h2 class="section__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="section__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        <a href="{{ coll.url | default: block.settings.link | default: '#' }}" class="category-card" {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.title | escape }}" width="500" height="500" loading="lazy">
            {%- elsif coll.featured_image -%}
              <img src="{{ coll.featured_image | image_url: width: 500 }}" alt="{{ coll.title | escape }}" width="500" height="500" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'category-card__placeholder' }}
            {%- endif -%}
          </div>
          <span class="category-card__title">{{ block.settings.title | default: coll.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Top brands across phones, watches and laptops" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "url", "id": "link", "label": "Link (if no collection)" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Apple Phones" } },
        { "type": "category", "settings": { "title": "Samsung" } },
        { "type": "category", "settings": { "title": "Oppo" } },
        { "type": "category", "settings": { "title": "Huawei" } },
        { "type": "category", "settings": { "title": "Watches" } },
        { "type": "category", "settings": { "title": "MacBooks" } },
        { "type": "category", "settings": { "title": "Laptops" } },
        { "type": "category", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
