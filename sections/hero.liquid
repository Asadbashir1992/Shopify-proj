<div class="hero" style="--hero-bg: {{ section.settings.bg_color }};">
  <div class="page-width hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--lg">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a href="{{ section.settings.button2_link }}" class="btn btn--lg btn--ghost">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.image != blank -%}
      <div class="hero__media">
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" width="900" height="700" loading="eager">
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trade & Retail" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Phones, Tablets, Watches & Laptops — at the right price" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Genuine stock from Apple, Samsung, Oppo & Huawei. Dispatched in 1 working day with 48-hour delivery available across the UK." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop all products" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button label", "default": "Wholesale enquiries" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0b1220" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
