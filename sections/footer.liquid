<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <span class="site-footer__logo">{{ settings.brand_name }}</span>
        <p>{{ settings.brand_tagline }}</p>
        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon-instagram' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon-facebook' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok">TikTok</a>{%- endif -%}
          {%- if settings.social_whatsapp != blank -%}<a href="{{ settings.social_whatsapp }}" aria-label="WhatsApp">WhatsApp</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'text' -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
            <div class="rte">{{ block.settings.content }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="site-footer__col site-footer__newsletter">
        <h3 class="site-footer__heading">Stay in the loop</h3>
        <p>Trade pricing, new stock and deals straight to your inbox.</p>
        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form__row">
            <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required aria-label="{{ 'general.newsletter.label' | t }}">
            <button type="submit" class="btn">{{ 'general.newsletter.button' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}<p class="form-success">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
        {% endform %}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name }}. All rights reserved.</p>
      <p class="site-footer__payments">Visa · Mastercard · Amex · PayPal · Apple Pay · Google Pay</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Policies" } },
        { "type": "text", "settings": { "heading": "Need help?" } }
      ]
    }
  ]
}
{% endschema %}
