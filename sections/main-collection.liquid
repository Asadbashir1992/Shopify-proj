<div class="page-width collection-page">
  <div class="collection-page__head">
    <h1 class="collection-page__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-page__desc rte">{{ collection.description }}</div>
    {%- endif -%}
    <p class="collection-page__count">{{ 'collections.general.items_count' | t: count: collection.products_count }}</p>
  </div>

  {%- if collection.products.size > 0 -%}
    {%- paginate collection.products by 24 -%}
    <div class="product-grid">
      {%- for product in collection.products -%}
        {% render 'product-card', card_product: product %}
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <p class="empty-state">{{ 'collections.general.no_products' | t }}</p>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
