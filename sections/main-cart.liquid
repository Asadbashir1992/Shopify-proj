<div class="page-width cart-page">
  <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    {% form 'cart', cart, class: 'cart-form' %}
      <div class="cart-items">
        {%- for item in cart.items -%}
          <div class="cart-item">
            <a href="{{ item.url }}" class="cart-item__media">
              {%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80">{%- endif -%}
            </a>
            <div class="cart-item__info">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              {%- unless item.variant.title contains 'Default' -%}<span class="cart-item__variant">{{ item.variant.title }}</span>{%- endunless -%}
              <span class="cart-item__price">{{ item.final_price | money }}</span>
            </div>
            <div class="cart-item__qty">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
            </div>
            <div class="cart-item__total">{{ item.final_line_price | money }}</div>
            <a href="{{ item.url_to_remove }}" class="cart-item__remove" aria-label="{{ 'cart.remove' | t }}">&times;</a>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-footer">
        <button type="submit" name="update" class="btn btn--ghost">Update</button>
        <div class="cart-footer__totals">
          <span class="cart-footer__subtotal">{{ 'cart.subtotal' | t }}: <strong>{{ cart.total_price | money }}</strong></span>
          <p class="cart-footer__note">{{ 'cart.taxes_note' | t }}</p>
          <button type="submit" name="checkout" class="btn btn--lg btn--block">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    {% endform %}
  {%- else -%}
    <div class="empty-state">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
