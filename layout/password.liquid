<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main class="password-page">
      <div class="password-page__inner">
        <h1 class="h1">{{ shop.name }}</h1>
        <p>{{ 'general.password_page.opening_soon' | t }}</p>
        {% form 'storefront_password' %}
          {{ form.errors | default_errors }}
          <input type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password_page.password_placeholder' | t }}">
          <button type="submit" class="btn">{{ 'general.password_page.enter' | t }}</button>
        {% endform %}
      </div>
    </main>
  </body>
</html>
